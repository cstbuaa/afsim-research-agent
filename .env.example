# Alibaba Cloud Model Studio (DashScope) OpenAI-compatible API.
DASHSCOPE_API_KEY=your-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen3.8-flash
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# PaperQA2 evidence-query controls.
PAPERQA_EMBEDDING_DIMENSION=1024
PAPERQA_DISABLE_THINKING=true
PAPERQA_EVIDENCE_K=5
PAPERQA_MAX_SOURCES=3
PAPERQA_CONCURRENCY=1

# Required only when the Tavily search provider is enabled.
TAVILY_API_KEY=
# Project-local persistent data.
AFSIM_RESEARCH_DATA_DIR=./data

# ---- Tactical Crow source collection --------------------------------------
# Tavily depth: "advanced" (better recall, 2 credits) or "basic" (1 credit).
TAVILY_SEARCH_DEPTH=advanced
# Identify yourself to publishers and OpenAlex (polite pool). Recommended.
CROW_CONTACT_EMAIL=
# OpenAlex now meters usage: ~$0.10/day without a key, $1/day (~1000 searches) with a
# free key. Strongly recommended: https://openalex.org (account -> API key).
OPENALEX_API_KEY=
# Free key gives a dedicated 1 req/s; without it the shared pool often returns 429.
SEMANTIC_SCHOLAR_API_KEY=
# Free key from https://core.ac.uk/services/api; CORE is skipped when blank.
CORE_API_KEY=
# Scholarly providers, in order (openalex, semantic_scholar, arxiv, core).
CROW_SCHOLARLY_PROVIDERS=openalex,semantic_scholar,arxiv,core
# Restrict scholarly results to recent work, e.g. 2000. Blank = no limit.
OPENALEX_MIN_YEAR=
# Total accepted sources per run (each query returns --max-web-results candidates).
CROW_MAX_SOURCES=12
CROW_ENABLE_SCHOLARLY=true
CROW_ENABLE_DOCTRINE=true
# Comma-separated override of the doctrine/official domain list.
CROW_DOCTRINE_DOMAINS=
# Explicit proxy for all downloads, e.g. http://127.0.0.1:7890 (Clash/V2Ray HTTP port).
# Shell HTTP(S)_PROXY variables are deliberately ignored.
CROW_HTTP_PROXY=http://127.0.0.1:7890
# Only for TUN-mode proxies whose DNS returns fake IPs (Clash fake-ip: 198.18.0.0/15).
# Without this, such answers are rejected as non-public by the SSRF guard.
CROW_ALLOWED_PROXY_CIDRS=

# ---- v0.3: screening, snowballing, follow-up rounds, local library ----------
# LLM title/abstract screening before download (score 0-3; below MIN is dropped).
CROW_ENABLE_SCREENING=true
CROW_SCREEN_MIN_SCORE=1
CROW_MAX_SCREENED_CANDIDATES=80
# Defense technical reports (DTIC, NPS, AFIT, RAND, NASA NTRS, NATO STO ...).
CROW_ENABLE_TECHNICAL_REPORTS=true
CROW_TECHNICAL_REPORT_DOMAINS=
# Citation snowballing from the best accepted scholarly sources (0 disables).
CROW_SNOWBALL_SEEDS=3
CROW_SNOWBALL_PER_SEED=10
# Follow-up rounds for under-covered research questions, and their source budget.
CROW_GAP_ROUNDS=1
CROW_GAP_ROUND_SOURCES=6
# Local library (e.g. CNKI/Wanfang PDFs you downloaded); comma-separated dirs.
CROW_LIBRARY_DIRS=./data/library
CROW_MAX_LIBRARY_SOURCES=6
# Parallel downloads and per-host circuit breaker (skip a host after N network/403/429 failures).
CROW_FETCH_WORKERS=4
CROW_HOST_FAILURE_LIMIT=2

# Tactic proposal (docs/design/crow-tactic-proposal-v1.md §10)
# Proposer defaults to DASHSCOPE_CHAT_MODEL. The red-team model should be a
# different model family from the proposer (default: DeepSeek on Bailian).
CROW_PROPOSER_MODEL=
CROW_REDTEAM_MODEL=deepseek-v4-pro
CROW_MAX_CANDIDATES=5
CROW_MAX_INNOVATIVE=2
CROW_IDEAS_PER_GAP=3
CROW_ENABLE_TRANSFER=false
CROW_CAPABILITY_CATALOG=
